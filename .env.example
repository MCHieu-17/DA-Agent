# Required when LLM_PROVIDER = "gemini"
GEMINI_API_KEY=

# Required when LLM_PROVIDER = "deepseek"
DEEPSEEK_API_KEY=

E2B_API_KEY=

# LLM runtime
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0

# Token/profile/tool limits
CHAT_HISTORY_MAX_MESSAGES=6
PROMPT_MAX_CHARS=12000
PROFILE_EXACT_ROW_LIMIT=100000
PROFILE_SAMPLE_ROWS=5000
PROFILE_TOP_K=8
QUERY_MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=30
MAX_TOOL_RETRIES=2
MAX_CODE_RETRIES=2
MAX_REPLANS=2
MAX_SYNTHESIS_RETRIES=2
DEFAULT_ARTIFACTS_DIR=artifacts
MAX_ARTIFACT_MB=20

# E2B isolation; outbound network is disabled by default.
E2B_TEMPLATE=
E2B_SANDBOX_TIMEOUT_SECONDS=300
E2B_CODE_TIMEOUT_SECONDS=60
E2B_ALLOW_INTERNET=false
