DA_ENVIRONMENT=production
DA_EXECUTOR_BACKEND=gvisor
DA_SANDBOX_IMAGE=registry.example/da-sandbox@sha256:REPLACE_WITH_RELEASE_DIGEST
DA_QUEUE_DSN=postgresql://da_worker:REPLACE@127.0.0.1/da_operations
DA_REPORTING_DSN=postgresql://da_reporting:REPLACE@reporting-db/reporting
DA_SOURCE_REGISTRY=/etc/da-agent/sources.json
DA_SNAPSHOT_DIR=/srv/da-agent/artifacts/snapshots
DA_LLM_PROVIDER=gemini
GEMINI_API_KEY=REPLACE
DA_RUN_TIMEOUT_SECONDS=900
DA_RUN_TOKEN_BUDGET=120000
